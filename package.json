{
  "name": "example-react-atom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "vite",
    "build": "pnpm check && vite build",
